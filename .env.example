# Local development opens with real researched businesses; API keys are optional.
PORT=3001
HOST=127.0.0.1
APP_URL=http://localhost:5173
DATABASE_PATH=./data/grow.db
# Optional daily snapshots. Keep a separate off-host copy for disaster recovery.
BACKUP_DIR=
BACKUP_RETENTION=7

# REQUIRED for production: a strong password (12+ characters), HTTPS URL.
ADMIN_EMAIL=admin@dhampurgreen.com
ADMIN_PASSWORD=

# Optional live listing checks (Google Cloud billing + Places API (New) enabled).
# Official-directory discovery works without this key; Google content is not saved.
GOOGLE_PLACES_API_KEY=
# AI recommendations and personalized drafts. Set a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional public business email enrichment via Hunter Domain Search.
HUNTER_API_KEY=

# Optional email sending. Requires a verified domain in Resend.
RESEND_API_KEY=
OUTREACH_FROM=
OUTREACH_REPLY_TO=care@dhampurgreen.com
# Must be explicitly enabled before the app can send a reviewed live draft.
OUTREACH_ENABLED=false

# Single process scheduler. A persistent, always-on server is required.
WORKER_ENABLED=true
# Google listing checks per UTC day; provider charges depend on fields requested.
DAILY_DISCOVERY_LIMIT=100
# Official website fetches per UTC day; results are reused for 24 hours.
DAILY_RESEARCH_LIMIT=40
# OpenAI requests per UTC day; not a rupee spending cap.
DAILY_AI_LIMIT=50
DAILY_ENRICHMENT_LIMIT=50
DAILY_EMAIL_LIMIT=30

# Bulk email needs the real business postal address in every email footer.
OUTREACH_POSTAL_ADDRESS=
# Optional WhatsApp Business Cloud API. Credentials stay on the private backend.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use an API version supported by your Meta application, e.g. vXX.0.
WHATSAPP_API_VERSION=
# Approved text-only template ID (body + optional static footer).
# Body variables: {{1}} business name, {{2}} matching products (both optional).
# Include "Reply STOP to opt out". Load it from Bulk campaigns > connection steps.
WHATSAPP_TEMPLATE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Subscribe Meta's messages webhook to your backend /api/webhooks/whatsapp.
DAILY_WHATSAPP_LIMIT=30
